<?xml version="1.0" encoding="utf-8"?>
<configuration>
<!-- App settings - placed outside system.webServer -->
<appSettings>
<add key="NODE_ENV" value="production" />
</appSettings>
 
<!-- ASP.NET request length limit (in KB) - 1GB = 1048576 KB -->
<system.web>
<httpRuntime maxRequestLength="1048576" executionTimeout="3600" />
</system.web>
 
<system.webServer>
<!-- Diagnostics (DEV ONLY): show detailed errors and iisnode logs -->
<httpErrors errorMode="Detailed" />
<asp scriptErrorSentToBrowser="true" />


<iisnode loggingEnabled="true" devErrorsEnabled="true" flushResponse="false" nodeProcessCommandLine="%programfiles%\nodejs\node.exe --max-old-space-size=4096" watchedFiles="web.config;*.js" nodeProcessCountPerApplication="1" maxConcurrentRequestsPerProcess="2048" maxNamedPipeConnectionRetry="100" namedPipeConnectionRetryDelay="250" promoteServerVars="NODE_ENV" maxRequestBufferSize="1073741824" />
<!-- Remove WebDAV (prevents 405 on PUT/DELETE and other conflicts) -->
<modules>
<remove name="WebDAVModule" />
</modules>
<handlers>
<remove name="WebDAV" />
<!-- iisnode handles all methods to server.js -->
<add name="iisnode" path="server.js" verb="*" modules="iisnode" />
</handlers>
<!-- Rewrite: static pass-through, then send everything else to Node -->
<rewrite>
<rules>
<!-- Serve existing files or directories directly -->
<rule name="StaticFilesPassThrough" stopProcessing="true">
<match url=".*" />
<conditions>
<add input="{REQUEST_FILENAME}" matchType="IsFile" />
<add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
</conditions>
<action type="None" />
</rule>
<!-- Send all other requests (GET/POST/PUT/DELETE/etc.) to Node -->
<rule name="NodeApp" stopProcessing="true">
<match url="(.*)" />
<conditions>
<add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
<add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
</conditions>
<action type="Rewrite" url="server.js" />
</rule>
</rules>
</rewrite>
<security>
<requestFiltering>
<!-- Allow large file uploads (1GB) for CSV connector -->
<requestLimits maxAllowedContentLength="1073741824" />
<!-- Explicitly allow common API verbs -->
<verbs>
<add verb="GET" allowed="true" />
<add verb="HEAD" allowed="true" />
<add verb="POST" allowed="true" />
<add verb="PUT" allowed="true" />
<add verb="DELETE" allowed="true" />
<add verb="PATCH" allowed="true" />
<add verb="OPTIONS" allowed="true" />
</verbs>
<!-- Keep node_modules hidden -->
<hiddenSegments>
<add segment="node_modules" />
</hiddenSegments>
</requestFiltering>
</security>
        <caching enabled="false" enableKernelCache="false" />
</system.webServer>
</configuration>